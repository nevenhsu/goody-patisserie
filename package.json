{
  "name": "goody",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "deploy": "npm run deploy:app:build && npm run deploy:database && npm run deploy:app:publish",
    "deploy:app": "npm run deploy:app:build && npm run deploy:app:publish",
    "deploy:app:build": "opennextjs-cloudflare build",
    "deploy:app:publish": "opennextjs-cloudflare deploy",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command \"PRAGMA optimize\" --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test": "tsx --test tests/domain/*.test.ts tests/game/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "generate:cloudflare-types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.18.0",
    "@payloadcms/db-d1-sqlite": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-r2": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "16.14.2",
    "next": "15.4.11",
    "payload": "3.86.0",
    "phaser": "4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260729.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "sharp": "0.34.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "wrangler": "4.115.0"
  },
  "type": "module"
}
